DATABASE_URL=sqlite:///./database/hr_advisor.db
DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
FASTAPI_BASE_URL=http://127.0.0.1:8000

# SMTP Email Configuration (required for Gmail OTP login and password reset)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_google_app_password
# SMTP_TLS=True
# FROM_EMAIL=your_email@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
FROM_EMAIL=

# Optional AI-generated HR audit explanations (configured in the backend only)
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
